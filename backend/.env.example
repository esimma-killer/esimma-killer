# ==============================================================================
# Plantilla de Variables de Entorno — E-SIIMA Killer (E-SIIMA 3)
# Copiar este archivo a `.env` para desarrollo local. NO subir `.env` a Git.
# ==============================================================================

# Configuracion General de la API
APP_NAME="E-SIIMA Killer API (E-SIIMA 3)"
APP_VERSION="0.2.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Politicas de CORS (separadas por coma para clientes Web y Flutter)
CORS_ORIGINS="http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080,*"

# Configuracion de Fragmentacion Horizontal (PostgreSQL Shards por id_campus)
# id_campus = 1 -> Campus Central (Nodo Maestro Local)
# id_campus = 2 -> Campus Sur (Nodo Maestro Remoto)
SHARD_CENTRAL_DSN="postgresql://esimma_user:synthetic_pass_only@localhost:5432/esimma_central"
SHARD_SUR_DSN="postgresql://esimma_user:synthetic_pass_only@localhost:5433/esimma_sur"
REPLICA_LECTURA_CENTRAL_DSN="postgresql://esimma_ro:synthetic_pass_only@localhost:5434/esimma_central"
REPLICA_LECTURA_SUR_DSN="postgresql://esimma_ro:synthetic_pass_only@localhost:5435/esimma_sur"

# Configuracion de Base Analitica (MongoDB Replica Set para logs_actividad y metricas)
MONGO_URI="mongodb://localhost:27017/esimma_analytics"

# Configuracion JWT (cambiar JWT_SECRET en cada entorno)
JWT_SECRET="cambiar-por-un-secreto-aleatorio-seguro"
JWT_ALGORITHM="HS256"
JWT_ACCESS_MINUTES="30"
JWT_REFRESH_DAYS="7"
